# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values ever reach the browser.

# --- Supabase (Project Settings -> API) ---
# Project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / publishable key - safe in the browser, RLS protects the data
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key - server only (products, api_cache, quota_log, cron). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Spoonacular (https://spoonacular.com/food-api/console) ---
# API key for "Use it up" recipes and shopping-list cost. Leave empty to always use TheMealDB.
SPOONACULAR_KEY=
# Daily points budget for the free plan; we fall back to TheMealDB before crossing it
SPOON_DAILY_POINTS=45

# --- TheMealDB / TheCocktailDB ---
# "1" is the free test key. Put your supporter key here if you have one.
MEALDB_KEY=1
COCKTAILDB_KEY=1

# --- Open Food Facts ---
# Goes in our User-Agent so OFF can reach us if we misbehave: "NutriLens/1.0 (contact: <this>)"
OFF_CONTACT_EMAIL=you@example.com

# --- Money ---
# Spoonacular prices are US cents; this converts them to an approximate ₹ estimate
USD_INR_RATE=84

# --- Web push (generate with: npm run gen:vapid) ---
# Public VAPID key, used by the browser to subscribe
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private VAPID key, server only
VAPID_PRIVATE_KEY=
# Contact for push services, mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com

# --- Cron ---
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Guest mode (sign-in is currently switched off, see README) ---
# Every visitor acts as this user. Defaults to the seeded demo account.
GUEST_EMAIL=demo@nutrilens.app

# --- App ---
# Public URL of the app, used to build invite links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
